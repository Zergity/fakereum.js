{
  "name": "fakereum-sdk",
  "version": "0.1.0",
  "description": "Client SDK for Fakereum forked-EVM sandboxes: discovery, account kinds, EIP-191 signed-message transactions, cross-chain import, and an EIP-1193 provider wrapper that routes a dapp onto a sandbox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zergity/fakereum.js",
    "directory": "sdk"
  },
  "keywords": [
    "ethereum",
    "evm",
    "fork",
    "sandbox",
    "eip-1193",
    "eip-191",
    "fakereum"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/Zergity/fakereum.js/tree/main/sdk#readme",
  "bugs": "https://github.com/Zergity/fakereum.js/issues"
}
